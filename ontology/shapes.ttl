    ] ;
    sh:property [
        sh:path genco:mlflowRunId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:startTimeMs ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
