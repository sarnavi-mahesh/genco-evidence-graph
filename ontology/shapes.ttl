genco:PhysicalEvidenceShape a sh:NodeShape ;
    sh:targetClass genco:PhysicalEvidence ;
    sh:property [
        sh:path genco:meanResidual ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path genco:maxResidual ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path genco:activeResidual ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path genco:reactiveResidual ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path genco:violationCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path genco:max_pbe_bus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path genco:hasMetricSemantics ;
        sh:qualifiedValueShape [ sh:class genco:MetricSemantics ] ;
        sh:qualifiedMinCount 8
    ] .

genco:MetricSemanticsShape a sh:NodeShape ;
    sh:targetClass genco:MetricSemantics ;
    sh:property [
        sh:path genco:metricName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:treatment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:aggregation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:population ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:comparisonTolerance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] .

genco:ArtifactShape a sh:NodeShape ;
    sh:targetClass genco:Artifact ;
    sh:property [
        sh:path genco:artifactPath ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:sha256 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9a-f]{64}$"
    ] .
