        sh:pattern "^[0-9a-f]{40}$"
    ] ;
    sh:property [
        sh:path genco:environmentHash ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9a-f]{64}$"
    ] ;
    sh:property [
        sh:path genco:pythonVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:runtimePlatform ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:torchVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:torchvisionVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:torchaudioVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:torchScatterVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:comparisonStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "passed"
    ] ;
    sh:property [
        sh:path genco:tolerancePolicyId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "genco-case14-baseline-equivalence-v1"
    ] ;
    sh:property [
        sh:path genco:tolerancePolicyHash ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "5020e627198d6209bdde3b8a0c5f2dbfde26a1a589070359eb6c85d8787e1a56"
    ] ;
    sh:property [
        sh:path genco:maximumVoltageDifference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path genco:maximumPowerDifference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:minInclusive 0
    ] .

genco:PredictionShape a sh:NodeShape ;
    sh:targetClass genco:Prediction ;
    sh:property [
        sh:path genco:predictionId ;
        sh:minCount 1 ;
