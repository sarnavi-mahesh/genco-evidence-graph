        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1
    ] ;
    sh:property [
        sh:path genco:hasPhysicalEvidence ;
        sh:qualifiedValueShape [ sh:class genco:PhysicalEvidence ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1
    ] ;
    sh:property [
        sh:path genco:hasReferenceCase ;
        sh:qualifiedValueShape [ sh:class genco:ReferenceCase ] ;
        sh:qualifiedMinCount 1
    ] .

genco:ReferenceCaseShape a sh:NodeShape ;
    sh:targetClass genco:ReferenceCase ;
    sh:property [
        sh:path genco:scenarioId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:distance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
