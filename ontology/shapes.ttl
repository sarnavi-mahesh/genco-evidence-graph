            sh:property [ sh:path genco:datasetSplit ; sh:hasValue "train" ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1
    ] ;
    sh:property [
        sh:path genco:mlflowRunId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path genco:startTimeMs ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer
    ] ;
    sh:property [
        sh:path genco:endTimeMs ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer
    ] ;
    sh:property [
        sh:path genco:graphkitCommit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9a-f]{40}$"
    ] .

genco:ReproductionRunShape a sh:NodeShape ;
    sh:targetClass genco:ReproductionRun ;
    sh:property [
